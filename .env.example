# ------------------------------------------------------------------
# João Marcos — variáveis de ambiente
# Copie para `.env` (desenvolvimento) ou cadastre na Vercel (produção).
# NUNCA commite o arquivo .env com valores reais.
# ------------------------------------------------------------------

# --- Banco de dados (PostgreSQL) ---------------------------------
# Produção: obrigatório. Funciona com Supabase, Neon, Vercel Postgres ou qualquer PostgreSQL.
# Em plataformas serverless use a string de conexão do POOLER (ex.: Supabase "Transaction pooler", porta 6543).
DATABASE_URL=
# Defina "false" apenas se o seu servidor PostgreSQL não usa SSL.
DATABASE_SSL=true
# Tamanho do pool de conexões por instância serverless (padrão 3).
DB_POOL_MAX=3

# Desenvolvimento SEM DATABASE_URL: o projeto usa PGlite (PostgreSQL em WASM), gravado nesta pasta.
# PGLITE_DIR=.data/pglite

# --- Segurança ---------------------------------------------------
# Obrigatório em produção, mínimo de 32 caracteres aleatórios. Gere com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# --- Site --------------------------------------------------------
# URL pública (sem barra no final). Usada em Open Graph, sitemap.xml e robots.txt.
SITE_URL=https://jo-o-marcos.vercel.app

# --- Armazenamento de arquivos (fotos e vídeos) -------------------
# "s3" em produção (qualquer serviço compatível com S3). "local" grava em disco: SOMENTE desenvolvimento.
STORAGE_DRIVER=s3
S3_BUCKET=
S3_REGION=auto
# Endpoint do provedor (deixe vazio para AWS S3). Ex. Cloudflare R2: https://<account>.r2.cloudflarestorage.com
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# URL pública base para ler os arquivos do bucket (sem barra no final).
S3_PUBLIC_BASE_URL=
# "true" para provedores que exigem path-style (MinIO, Supabase Storage S3).
S3_FORCE_PATH_STYLE=false

# --- Desenvolvimento local ---------------------------------------
# LOCAL_UPLOAD_DIR=.data/uploads
# API_PORT=8787

# --- Criação do primeiro administrador (script `npm run admin:create`) ---
# Opcional: se não definidos, o script pergunta no terminal.
# ADMIN_EMAIL=
# ADMIN_NAME=
# ADMIN_PASSWORD=
